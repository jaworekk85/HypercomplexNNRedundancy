{
  "output": "results/compression_curve_eurosat",
  "dataset": "eurosat",
  "data": ".cache/eurosat/prepared",
  "training_output": "results/eurosat_cnn",
  "architectures": ["cnn6", "real_cnn6"],
  "seeds": [2026, 2027, 2028],
  "fractions": [0.125, 0.25, 0.5, 0.75, 0.875],
  "ridge_alpha": 0.001,
  "random_repetitions": 5,
  "random_seed_offset": 800000,
  "fit_half": "even calibration images (500)",
  "check_half": "odd calibration images (500)",
  "batch_size": 128,
  "device": "cuda",
  "cpu_threads": 4,
  "equivalence_tolerance": 0.001,
  "equivalence_images": 200,
  "limits": null,
  "finetune": {
    "enabled": true,
    "policies": ["baseline", "random", "bn_pruned", "random_comp", "greedy_comp"],
    "random_repetitions_finetuned": 3,
    "epochs": 3,
    "batch_size": 128,
    "learning_rate": 0.0001,
    "minimum_learning_rate": 0.000001,
    "weight_decay": 0.0001,
    "mixed_precision": true,
    "order_seed_offset": 80000,
    "augment_seed_offset": 90000
  },
  "scratch": {
    "enabled": true,
    "fractions": [0.25, 0.5, 0.75, 0.875],
    "epochs": null
  },
  "comparisons": [
    ["greedy_comp@before", "random@before"],
    ["greedy_comp@before", "bn_pruned@before"],
    ["greedy_comp@before", "greedy_pruned@before"],
    ["random_comp@before", "random@before"],
    ["greedy_comp@before", "random_comp@before"],
    ["greedy_comp@before", "greedy_full_projected@before"],
    ["greedy_comp@after", "random@after"],
    ["greedy_comp@after", "bn_pruned@after"],
    ["random_comp@after", "random@after"],
    ["greedy_comp@after", "random_comp@after"],
    ["greedy_comp@after", "scratch@scratch"],
    ["bn_pruned@after", "scratch@scratch"],
    ["random@after", "scratch@scratch"]
  ],
  "official_test_evaluation": false,
  "scope": "EuroSAT four-band replication of configs/compression_curve.json with identical rules (see that file for policies, outcome and questions). Run after the CIFAR curve. Official EuroSAT test split held out."
